<Window x:Class="EndfieldMaterialStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZZZ Material Studio" Height="860" Width="1380"
        MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterScreen"
        Background="#F3F4F6" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1677FF"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="新建 / 导入 PMX" Click="ImportPmx_Click"/>
                    <Button Content="打开工程" Click="OpenProject_Click"/>
                    <Button Content="保存工程" Click="SaveProject_Click"/>
                    <Separator Width="12" Opacity="0"/>
                    <Button Content="自动匹配贴图" Click="AutoMatch_Click"/>
                    <Button x:Name="EyeThroughDerivedButton" Content="旧运行时：生成眼透派生 PMX" Click="GenerateEyeThrough_Click"/>
                    <Button Content="检查工程" Click="Validate_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="生成角色包与 EMM" Click="GeneratePackage_Click"
                        Background="{StaticResource Accent}" Foreground="White" BorderBrush="#1168D8" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="#FFFFFF" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="PMX"/>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="PmxPathBox" IsReadOnly="True" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="选择" Click="BrowsePmx_Click" Margin="0" MinWidth="64"/>
            </Grid>
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="运行时"/>
            <Grid Grid.Row="0" Grid.Column="3" Margin="0,0,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RuntimePathBox" IsReadOnly="True" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="选择" Click="BrowseRuntime_Click" Margin="0" MinWidth="64"/>
            </Grid>
            <TextBlock Grid.Row="0" Grid.Column="4" Style="{StaticResource FieldLabel}" Text="头骨"/>
            <TextBox Grid.Row="0" Grid.Column="5" x:Name="HeadBoneBox" Margin="0,0,0,6" TextChanged="ProjectHeader_Changed"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="输出"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="OutputPathBox" IsReadOnly="True" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="选择" Click="BrowseOutput_Click" Margin="0" MinWidth="64"/>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                <CheckBox x:Name="EyeThroughCheck" Content="启用眼透" Margin="0,6,18,0" Checked="ProjectHeader_Changed" Unchecked="ProjectHeader_Changed"/>
                <CheckBox x:Name="DerivedPmxCheck" Content="旧运行时自动生成派生 PMX" Margin="0,6,18,0" Checked="ProjectHeader_Changed" Unchecked="ProjectHeader_Changed"/>
                <TextBlock Margin="18,6,8,0" Foreground="#4B5563" Text="工程名"/>
                <TextBox x:Name="ProjectNameBox" Width="250" TextChanged="ProjectHeader_Changed"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="官方 JSON"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="OfficialJsonRootBox" Margin="0,0,6,0" TextChanged="ProjectHeader_Changed"/>
                <Button Grid.Column="1" Content="选择目录" Click="BrowseOfficialJson_Click" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="读取当前材质候选" Click="ApplyOfficialJson_Click" Margin="0"/>
            </Grid>
            <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                <CheckBox x:Name="PreferManualMatCapCheck" Content="MatCap 手动优先" Margin="0,6,18,0" IsChecked="True"
                          Checked="ProjectHeader_Changed" Unchecked="ProjectHeader_Changed"/>
                <TextBlock Margin="0,6,8,0" Foreground="#6B7280" Text="JSON 只补空槽，不静默覆盖手动贴图"/>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="控制器"/>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,6,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ControllerRootBox" Margin="0,0,6,0" TextChanged="ProjectHeader_Changed"/>
                <Button Grid.Column="1" Content="选择目录" Click="BrowseControllerRoot_Click" Margin="0"/>
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="4" Margin="0,12,0,0" Foreground="#6B7280"
                       Text="控制器目录可覆盖运行时默认 PMX；未指定时使用运行时 controller 文件夹。"/>
        </Grid>

        <TabControl Grid.Row="2" Margin="16,12,16,10">
        <TabItem Header="材质 / MatCap">
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" MinWidth="520"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.88*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock Text="PMX 材质映射" FontWeight="SemiBold" FontSize="14"/>
                    </Border>
                    <DataGrid x:Name="MaterialsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="MaterialsGrid_SelectionChanged"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderThickness="0"
                              RowHeaderWidth="0" AlternatingRowBackground="#F9FAFB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding MaterialIndex}" Width="52"/>
                            <DataGridTextColumn Header="材质名" Binding="{Binding MaterialName}" Width="2*"/>
                            <DataGridTextColumn Header="英文名" Binding="{Binding EnglishName}" Width="1.3*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Role}" Width="120"/>
                            <DataGridTextColumn Header="基础贴图" Binding="{Binding PmxBaseTexture}" Width="1.6*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="SelectedMaterialTitle" Text="选择一个材质" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="SelectedMaterialHint" Foreground="#6B7280" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <Grid x:Name="MaterialEditor" Margin="12,12,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="材质类型"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RoleCombo" SelectionChanged="RoleCombo_SelectionChanged" Margin="0,0,0,8"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UsePmxBaseCheck" Content="基础色使用 PMX 原贴图"
                                      Checked="UsePmxBase_Changed" Unchecked="UsePmxBase_Changed" Margin="0,2,0,9"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Base"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="BaseBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Base"/>
                            <Button Grid.Row="2" Grid.Column="2" x:Name="BaseBrowseButton" Content="选择" Tag="Base" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Normal / N"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="NormalBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Normal"/>
                            <Button Grid.Row="3" Grid.Column="2" x:Name="NormalBrowseButton" Content="选择" Tag="Normal" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Property / M"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PropertyBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Property"/>
                            <Button Grid.Row="4" Grid.Column="2" x:Name="PropertyBrowseButton" Content="选择" Tag="Property" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="RD"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="RdBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Rd"/>
                            <Button Grid.Row="5" Grid.Column="2" x:Name="RdBrowseButton" Content="选择" Tag="Rd" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Attribute / A"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="RsBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Rs"/>
                            <Button Grid.Row="6" Grid.Column="2" x:Name="RsBrowseButton" Content="选择" Tag="Rs" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="LUT"/>
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="LutBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Lut"/>
                            <Button Grid.Row="7" Grid.Column="2" x:Name="LutBrowseButton" Content="选择" Tag="Lut" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="FaceLight / SDF"/>
                            <TextBox Grid.Row="8" Grid.Column="1" x:Name="SdfBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="Sdf"/>
                            <Button Grid.Row="8" Grid.Column="2" x:Name="SdfBrowseButton" Content="选择" Tag="Sdf" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="ST"/>
                            <TextBox Grid.Row="9" Grid.Column="1" x:Name="StBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="St"/>
                            <Button Grid.Row="9" Grid.Column="2" x:Name="StBrowseButton" Content="选择" Tag="St" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Color Mask"/>
                            <TextBox Grid.Row="10" Grid.Column="1" x:Name="ColorMaskBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="ColorMask"/>
                            <Button Grid.Row="10" Grid.Column="2" x:Name="ColorMaskBrowseButton" Content="选择" Tag="ColorMask" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Lip Specular"/>
                            <TextBox Grid.Row="11" Grid.Column="1" x:Name="LipSpecularBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="LipSpecular"/>
                            <Button Grid.Row="11" Grid.Column="2" x:Name="LipSpecularBrowseButton" Content="选择" Tag="LipSpecular" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Hair Line"/>
                            <TextBox Grid.Row="12" Grid.Column="1" x:Name="HairLineBox" Margin="0,0,6,6" TextChanged="TextureBox_Changed" Tag="HairLine"/>
                            <Button Grid.Row="12" Grid.Column="2" x:Name="HairLineBrowseButton" Content="选择" Tag="HairLine" Click="BrowseTexture_Click" Margin="0,0,0,6"/>
                            <Button Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Content="清空当前材质的非基础贴图" Click="ClearMaterialTextures_Click" Margin="0,7,0,0"/>
                        </Grid>
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Margin="12,0,12,10" Padding="9,7">
                            <TextBlock x:Name="TextureContractText" Foreground="#4B5563" TextWrapping="Wrap"/>
                        </Border>
                        <Expander x:Name="HairSettingsExpander" Header="ZZZ 头发高光" IsExpanded="True" Margin="12,2,12,10">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="高光材质槽"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HairHighlightSlotCombo" Margin="0,0,10,6"
                                          SelectionChanged="HairSettings_Changed"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="合成亮度"/>
                                <TextBox Grid.Row="0" Grid.Column="3" x:Name="HairHighlightGainBox" Margin="0,0,0,6"
                                         TextChanged="HairSettings_TextChanged"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="中央收窄"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="HairCenterPowerBox" Margin="0,0,10,0"
                                         TextChanged="HairSettings_TextChanged"/>
                                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <CheckBox x:Name="HairCenterMaskCheck" Content="中央遮罩" Margin="0,6,12,0"
                                              Checked="HairSettings_Changed" Unchecked="HairSettings_Changed"/>
                                    <CheckBox x:Name="HairScreenRimCheck" Content="屏幕边缘光" Margin="0,6,12,0"
                                              Checked="HairSettings_Changed" Unchecked="HairSettings_Changed"/>
                                    <CheckBox x:Name="HairFaceShadowCheck" Content="刘海偏移阴影" Margin="0,6,0,0"
                                              Checked="HairSettings_Changed" Unchecked="HairSettings_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Expander>
                        <Expander x:Name="MatCapsExpander" Header="ZZZ MatCap 五槽（手动优先）" IsExpanded="True" Margin="12,0,12,12">
                            <DataGrid x:Name="MatCapsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="276"
                                      RowHeaderWidth="0" AlternatingRowBackground="#F9FAFB" CellEditEnding="MatCapsGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="槽" Binding="{Binding Slot}" Width="36" IsReadOnly="True"/>
                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                                    <DataGridComboBoxColumn Header="来源" SelectedItemBinding="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding DataContext.MatCapSources, RelativeSource={RelativeSource AncestorType=Window}}" Width="92"/>
                                    <DataGridTextColumn Header="官方贴图" Binding="{Binding OfficialTextureName}" Width="1.2*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="手动贴图" Binding="{Binding ManualTexturePath, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                    <DataGridTemplateColumn Header="选择" Width="54">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="..." Tag="{Binding}" Click="BrowseMatCap_Click" Padding="4,2" Margin="1"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="强度" Binding="{Binding Intensity, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="68"/>
                                    <DataGridComboBoxColumn Header="混合" SelectedItemBinding="{Binding BlendMode, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding DataContext.MatCapBlendModes, RelativeSource={RelativeSource AncestorType=Window}}" Width="78"/>
                                    <DataGridComboBoxColumn Header="遮罩" SelectedItemBinding="{Binding MaskChannel, UpdateSourceTrigger=PropertyChanged}"
                                                            ItemsSource="{Binding DataContext.MatCapMaskChannels, RelativeSource={RelativeSource AncestorType=Window}}" Width="56"/>
                                    <DataGridTextColumn Header="旋转" Binding="{Binding Rotation, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}" Width="62"/>
                                    <DataGridTextColumn Header="缩放X" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="62"/>
                                    <DataGridTextColumn Header="缩放Y" Binding="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="62"/>
                                    <DataGridTextColumn Header="偏移X" Binding="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="62"/>
                                    <DataGridTextColumn Header="偏移Y" Binding="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="62"/>
                                    <DataGridTextColumn Header="色R" Binding="{Binding Tint.R, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="54"/>
                                    <DataGridTextColumn Header="色G" Binding="{Binding Tint.G, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="54"/>
                                    <DataGridTextColumn Header="色B" Binding="{Binding Tint.B, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="54"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </TabItem>

        <TabItem Header="控制器">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="112"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Padding="12,9" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock x:Name="ControllerSummaryText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#6B7280"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="分组"/>
                            <ComboBox x:Name="ControllerGroupCombo" Width="150" Margin="0,0,10,0" SelectionChanged="ControllerGroupCombo_SelectionChanged"/>
                            <Button Content="重新读取 PMX" Click="ReloadControllers_Click"/>
                            <Button Content="启用当前组" Click="EnableControllerGroup_Click"/>
                            <Button Content="停用当前组" Click="DisableControllerGroup_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid Grid.Row="1" x:Name="ControllerBindingsGrid" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F9FAFB"
                          BorderBrush="#D1D5DB" BorderThickness="1" CellEditEnding="ControllerBindingsGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                        <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="78" IsReadOnly="True"/>
                        <DataGridTextColumn Header="控制器 PMX" Binding="{Binding ControllerFile}" Width="210" IsReadOnly="True"/>
                        <DataGridTextColumn Header="表情名" Binding="{Binding MorphName}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="内部参数键" Binding="{Binding TargetProperty, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                        <DataGridTextColumn Header="中性" Binding="{Binding Default, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="66"/>
                        <DataGridTextColumn Header="最小" Binding="{Binding Min, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="66"/>
                        <DataGridTextColumn Header="最大" Binding="{Binding Max, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="66"/>
                        <DataGridTextColumn Header="说明" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="1.8*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,8,0,0" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="实际打包控制器 PMX" FontWeight="SemiBold"/>
                            <TextBlock Text="只加载此列表中的文件" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Column="1" x:Name="ControllerFilesList" Margin="8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="添加" Click="AddControllerFile_Click"/>
                            <Button Content="移除" Click="RemoveControllerFile_Click"/>
                            <Button Content="恢复默认" Click="ResetControllerFiles_Click" Margin="0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="16,0,16,10" Background="#111827" BorderBrush="#111827" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="检查与生成日志" Foreground="#D1D5DB" FontWeight="SemiBold" Padding="10,7"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="#E5E7EB"
                         BorderThickness="0" FontFamily="Consolas" Padding="10,4"/>
            </DockPanel>
        </Border>

        <StatusBar Grid.Row="4" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="请选择一个普通 PMX 开始。"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
